rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function myEmail() { return request.auth.token.email.lower(); }

    // اشتراك الشروحات: المشرف يضيف بريد الطالب في access/{البريد}
    // ونشترط إن البريد مؤكد، عشان ما أحد يسجل ببريد غيره وياخذ اشتراكه
    function accessDoc() { return get(/databases/$(database)/documents/access/$(myEmail())); }
    function hasAccess() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/access/$(myEmail()))
        && (!('until' in accessDoc().data) || accessDoc().data.until > request.time);
    }

    // تقدم كل طالب (الخطة، الجدول، المعدل): هو بس يقرأ ويكتب ملفه
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // إعلانات التدريب التعاوني: القراءة للكل، والكتابة للمشرفين
    match /coop/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.org is string && request.resource.data.org.size() > 0 && request.resource.data.org.size() <= 100
        && request.resource.data.city is string && request.resource.data.city.size() > 0
        && request.resource.data.link is string && request.resource.data.link.matches('https?://.+');
      allow delete: if isAdmin();
    }

    // منتجات المتجر (روابط سلة/زد): القراءة للكل، والكتابة للمشرفين
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // إعدادات عامة مثل شريط الإعلان: القراءة للكل، والكتابة للمشرفين
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // الشروحات: العنوان والوصف للمسجلين، والرابط نفسه في lessonLinks
    match /lessons/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /lessonLinks/{id} {
      allow read: if isAdmin()
        || (signedIn() && (get(/databases/$(database)/documents/lessons/$(id)).data.free == true || hasAccess()));
      allow write: if isAdmin();
    }

    // المشتركين في الشروحات: الطالب يشوف اشتراكه بس، والمشرف يدير الكل
    match /access/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email != null && email == myEmail());
      allow write: if isAdmin();
    }

    // الاختبارات: العنوان والوصف للمسجلين، والأسئلة نفسها في quizData
    match /quizzes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /quizData/{id} {
      allow read: if isAdmin()
        || (signedIn() && (get(/databases/$(database)/documents/quizzes/$(id)).data.free == true || hasAccess()));
      allow write: if isAdmin();
    }

    // التقويم الأكاديمي وآراء الطلاب وأسماء الأعضاء: القراءة للكل، والكتابة للمشرفين
    match /calendar/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // صندوق آراء الطلاب: أي زائر يرسل رأي (بدون تسجيل)، والقراءة والحذف للمشرفين فقط
    match /testimonialInbox/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'role', 'text', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
        && request.resource.data.role is string && request.resource.data.role.size() <= 60
        && request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 320
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }
    match /instructors/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // تقييمات المقررات والأعضاء: تقييم واحد لكل طالب لكل عنصر (رقم المستند = العنصر_رقم الطالب).
    // التقييم بدون تعليق ينشر على طول، والتعليق المكتوب يبقى "pending" لين يوافق المشرف.
    function validReview(id) {
      let d = request.resource.data;
      return signedIn()
        && d.keys().hasOnly(['target', 'uid', 'rating', 'level', 'tip', 'status', 'createdAt'])
        && d.uid == request.auth.uid
        && d.target is string && id == d.target + '_' + request.auth.uid
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.level is int && d.level >= 1 && d.level <= 5
        && d.tip is string && d.tip.size() <= 400
        && ((d.tip.size() == 0 && d.status == 'approved') || (d.tip.size() > 0 && d.status == 'pending'));
    }
    function canSeeReview() {
      return resource.data.status == 'approved' || isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /courseReviews/{id} {
      allow get: if resource == null || canSeeReview();
      allow list: if canSeeReview();
      allow create, update: if validReview(id) || isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /instructorReviews/{id} {
      allow get: if resource == null || canSeeReview();
      allow list: if canSeeReview();
      allow create, update: if validReview(id) || isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // المشرفين: تضيفهم يدويًا من Firebase Console، وكل واحد يقدر يشيك على نفسه بس
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
